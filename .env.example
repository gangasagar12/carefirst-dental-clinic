# Security Settings
DEBUG=False
SECRET_KEY=replace-this-with-a-very-secure-random-string
ALLOWED_HOSTS=nikodental.com,www.nikodental.com,127.0.0.1,localhost

# Database Settings (PostgreSQL)
USE_POSTGRES=True
DB_NAME=niko_dental
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432

# Email Settings (for contact forms)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_clinic_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_specific_password
DEFAULT_FROM_EMAIL=your_clinic_email@gmail.com

# Google Reviews
# Keep these server-side only. Do not expose the API key in frontend JavaScript.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_PLACE_ID=your_google_place_id
