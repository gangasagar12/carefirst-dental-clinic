# .env.production
# RENAME THIS FILE TO .env AFTER UPLOADING TO CPANEL

# Disable DEBUG mode for production
DEBUG=False

# Add your domain
ALLOWED_HOSTS=nikodentistry.com,www.nikodentistry.com
CSRF_TRUSTED_ORIGINS=https://nikodentistry.com,https://www.nikodentistry.com

# Database Configuration (Update with your actual cPanel Database Name and Password)
USE_MYSQL=True
DB_NAME=nikodent_niko_dental
DB_USER=nikodent_ganga
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=3306

# URL formatted for dj_database_url (Remember to URL-encode @ and # in the password)
# Example: mysql://nikodent_ganga:your_encoded_password@localhost:3306/nikodent_dbname
DATABASE_URL=mysql://nikodent_ganga:ganga%4012345%23%23%23@localhost:3306/nikodent_niko_dental

# Email Configuration (for Notifications)
EMAIL_HOST=mail.nikodentistry.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=contact@nikodentistry.com
EMAIL_HOST_PASSWORD="nikodental@12345"
DEFAULT_FROM_EMAIL=contact@nikodentistry.com
NOTIFICATION_EMAIL=nikodentalandaesthetics@gmail.com
